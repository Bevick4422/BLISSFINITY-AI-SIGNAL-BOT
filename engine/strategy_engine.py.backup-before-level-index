# ==========================================================
# MARKET VALIDATION
# ==========================================================

def validate_market(
    market: Dict[str, Any],
) -> bool:
    """
    Validate downloaded market data.

    Required:
        1d
        4h

    Each timeframe must contain at least 50 candles.
    """

    if not isinstance(market, dict):
        return False

    required_timeframes = ("1d", "4h")

    for timeframe in required_timeframes:

        if timeframe not in market:
            return False

        dataframe = market[timeframe]

        if dataframe is None:
            return False

        if len(dataframe) < 50:
            return False

    return True


# ==========================================================
# MARKET REGIME
# ==========================================================

def detect_market_regime(h4) -> str:
    """
    Detect overall H4 market condition.

    Returns:
        TRENDING
        RANGING
        HIGH_VOLATILITY
    """

    recent = h4.tail(20)

    highest = recent["high"].max()
    lowest = recent["low"].min()

    movement = highest - lowest

    average_range = (
        recent["high"] - recent["low"]
    ).mean()

    if average_range <= 0:
        return "RANGING"

    ratio = movement / average_range

    if ratio >= 5:
        return "TRENDING"

    if ratio <= 2:
        return "RANGING"

    return "HIGH_VOLATILITY"


# ==========================================================
# SAVED SETUP VALIDATION
# ==========================================================

def validate_setup(
    setup: Optional[Dict[str, Any]],
) -> bool:
    """
    Validate a saved Daily rejection setup.
    """

    if setup is None:
        return False

    required = (
        "symbol",
        "direction",
        "setup",
        "status",
        "level",
    )

    return all(
        key in setup
        for key in required
    )


# ==========================================================
# CREATE DAILY SETUP
# ==========================================================

def create_daily_setup(
    symbol: str,
    daily,
) -> Optional[Dict[str, Any]]:
    """
    Analyse the Daily timeframe.

    Daily setup is the directional authority.

    Bullish Engulfing
        → BUY
        → Immediate signal

    Bearish Engulfing
        → SELL
        → Immediate signal

    V Shape
        → BUY
        → Save and wait for bullish H4 BOS

    A Shape
        → SELL
        → Save and wait for bearish H4 BOS
    """

    # ------------------------------------------------------
    # Detect Daily Setup
    # ------------------------------------------------------

    result = detect_daily_setup(daily)

    if result is None:
        return None

    if not result.get("valid", False):
        return None

    setup_name = result.get("setup")
    setup_direction = result.get("direction")

    if setup_direction not in ("BUY", "SELL"):
        if DEBUG:
            print(
                f"{symbol} | Invalid Daily direction: "
                f"{setup_direction}"
            )

        return None

    # ------------------------------------------------------
    # DEBUG
    # ------------------------------------------------------

    if DEBUG:

        print("\n" + "=" * 60)
        print(symbol)
        print("=" * 60)
        print(f"Daily Setup : {setup_name}")
        print(f"Direction    : {setup_direction}")
        print(f"Level        : {result.get('level')}")
        print("=" * 60)

    # ------------------------------------------------------
    # DAILY ENGULFING
    # ------------------------------------------------------
    #
    # Immediate signal.
    # H4 BOS is NOT required.
    # ------------------------------------------------------

    engulfing = detect_daily_engulfing_signal(result)

    if engulfing is not None:

        direction = engulfing.get("direction")

        # Safety check:
        # detector direction must match Daily setup direction.

        if direction != setup_direction:

            if DEBUG:
                print(
                    f"{symbol} | Daily Engulfing "
                    f"Direction Conflict"
                )

            return None

        entry_price = float(
            daily.iloc[-1]["close"]
        )

        signal = build_signal(
            symbol=symbol,
            direction=direction,
            setup=setup_name,
            candle=daily.iloc[-1],
            entry=entry_price,
            entry_type="ENGULFING",
        )

        if signal is None:

            if DEBUG:
                print(
                    f"{symbol} | Failed To Build "
                    f"Engulfing Signal"
                )

            return None

        if DEBUG:
            print(
                f"{symbol} | Daily Engulfing "
                f"Signal Generated | {direction}"
            )

        return signal

    # ------------------------------------------------------
    # DAILY REJECTION
    # ------------------------------------------------------

    rejection = detect_daily_rejection_signal(result)

    if rejection is None:
        return None

    rejection_direction = rejection.get("direction")

    # ------------------------------------------------------
    # DIRECTION SAFETY
    # ------------------------------------------------------
    #
    # Rejection direction must match the Daily setup.
    # It must NEVER reverse the setup direction.
    # ------------------------------------------------------

    if rejection_direction != setup_direction:

        if DEBUG:
            print(
                f"{symbol} | Daily Rejection "
                f"Direction Conflict"
            )

        return None

    level = result.get("level")

    if level is None:

        if DEBUG:
            print(
                f"{symbol} | Rejection level missing"
            )

        return None

    try:
        level = float(level)
    except (TypeError, ValueError):

        if DEBUG:
            print(
                f"{symbol} | Invalid rejection level"
            )

        return None

    # ------------------------------------------------------
    # SAVE DAILY REJECTION SETUP
    # ------------------------------------------------------

    setup_data = {
        "symbol": symbol,
        "direction": rejection_direction,
        "setup": setup_name,
        "status": "WAITING_FOR_BOS",
        "method": "DAILY_REJECTION",
        "level": level,
        "bos": False,
        "signal_sent": False,
        "created_at": None,
    }

    add_setup(setup_data)

    if DEBUG:
        print(
            f"{symbol} | Daily Rejection Saved | "
            f"{rejection_direction}"
        )

    return None


# ==========================================================
# EVALUATE SYMBOL
# ==========================================================

def evaluate_symbol(
    symbol: str,
    market: Dict[str, Any],
) -> Optional[Dict[str, Any]]:
    """
    Main production strategy evaluation.

    The Daily setup determines direction.

    Engulfing:
        Immediate signal.

    Rejection:
        Wait for matching H4 BOS.
    """

    try:

        # ==================================================
        # VALIDATE MARKET
        # ==================================================

        if not validate_market(market):

            if DEBUG:
                print(
                    f"{symbol} | Invalid Market Data"
                )

            return None

        daily = market["1d"]
        h4 = market["4h"]

        # ==================================================
        # MARKET REGIME
        # ==================================================

        regime = detect_market_regime(h4)

        if regime == "RANGING":

            if DEBUG:
                print(
                    f"{symbol} | Market Ranging"
                )

            return None

        if DEBUG:
            print(
                f"{symbol} | Market Regime : {regime}"
            )

        # ==================================================
        # LOAD SAVED DAILY REJECTION SETUP
        # ==================================================

        setup = get_setup(symbol)

        if setup is not None:

            # ------------------------------------------------
            # Validate stored setup
            # ------------------------------------------------

            if not validate_setup(setup):

                if DEBUG:
                    print(
                        f"{symbol} | Invalid Saved Setup"
                    )

                remove_setup(symbol)

                return None

            # ------------------------------------------------
            # Validate stored direction
            # ------------------------------------------------

            direction = setup.get("direction")

            if direction not in ("BUY", "SELL"):

                if DEBUG:
                    print(
                        f"{symbol} | Invalid Setup Direction"
                    )

                remove_setup(symbol)

                return None

        # ==================================================
        # CREATE NEW DAILY SETUP
        # ==================================================

        if setup is None:

            return create_daily_setup(
                symbol=symbol,
                daily=daily,
            )

        # ==================================================
        # SETUP STATUS
        # ==================================================

        if setup.get("status") != "WAITING_FOR_BOS":

            if DEBUG:
                print(
                    f"{symbol} | Invalid Setup Status"
                )

            remove_setup(symbol)

            return None

        direction = setup["direction"]

        # ==================================================
        # H4 BOS CONFIRMATION
        # ==================================================
        #
        # CRITICAL:
        #
        # BUY setup → only bullish BOS
        # SELL setup → only bearish BOS
        #
        # Opposite BOS = NO SIGNAL.
        # Never reverse direction.
        # ==================================================

        if direction == "BUY":

            bos = bullish_bos(h4)

        elif direction == "SELL":

            bos = bearish_bos(h4)

        else:

            remove_setup(symbol)

            return None

        if not bos:

            if DEBUG:
                print(
                    f"{symbol} | Waiting For "
                    f"{direction} H4 BOS"
                )

            return None

        if DEBUG:
            print(
                f"{symbol} | {direction} H4 BOS Confirmed"
            )

        # ==================================================
        # ENTRY SELECTION
        # ==================================================

        entry = select_best_entry(
            df=h4,
            level=setup["level"],
            direction=direction,
        )

        if entry is None:

            if DEBUG:
                print(
                    f"{symbol} | No Valid Entry"
                )

            return None

        if not entry.get("entry_data", {}).get(
            "valid",
            False,
        ):

            if DEBUG:
                print(
                    f"{symbol} | Entry Validation Failed"
                )

            return None

        # ==================================================
        # CURRENT MARKET PRICE
        # ==================================================

        current_price = float(
            h4.iloc[-1]["close"]
        )

        entry_price = entry.get("entry_price")

        # ==================================================
        # ENTRY VALIDATION
        # ==================================================

        if entry["entry_type"] == "ENGULFING":

            # Market execution.

            entry_price = current_price

        else:

            if entry_price is None:

                if DEBUG:
                    print(
                        f"{symbol} | Entry Price Missing"
                    )

                return None

            distance = abs(
                current_price - entry_price
            ) / current_price

            # Reject stale entries more than 1% away.

            if distance > 0.01:

                if DEBUG:
                    print(
                        f"{symbol} | Stale Entry Rejected "
                        f"({distance * 100:.2f}% from market)"
                    )

                return None

        entry["entry_price"] = entry_price

        if DEBUG:
            print(
                f"{symbol} | Entry : "
                f"{entry['entry_type']}"
            )

        # ==================================================
        # STOP LOSS
        # ==================================================

        stop = calculate_stop_loss(
            df=h4,
            entry_price=entry_price,
            direction=direction,
        )

        if stop is None:

            if DEBUG:
                print(
                    f"{symbol} | Stop Loss Failed"
                )

            return None

        stop_loss = stop.get("stop_loss")

        if stop_loss is None:

            if DEBUG:
                print(
                    f"{symbol} | Stop Loss Value Missing"
                )

            return None

        # ==================================================
        # BUILD SIGNAL
        # ==================================================

        signal = build_signal(
            symbol=symbol,
            direction=direction,
            setup=setup["setup"],
            candle=h4.iloc[-1],
            entry=entry_price,
            entry_type=entry["entry_type"],
            stop_loss=stop_loss,
        )

        if signal is None:

            if DEBUG:
                print(
                    f"{symbol} | Signal Build Failed"
                )

            return None

        # ==================================================
        # CONFIDENCE SCORE
        # ==================================================
        #
        # The old engine awarded 20 points specifically
        # for EMA Daily Bias.
        #
        # That bias is no longer a directional authority.
        #
        # Replace those points with confirmation that a
        # valid Daily setup exists.
        # ==================================================

        score = 0

        # H4 BOS
        score += 25

        # Market regime
        if regime == "TRENDING":
            score += 20

        # Valid Daily setup
        score += 20

        # Entry quality
        entry_scores = {
            "LEFT_SHOULDER": 35,
            "BREAK_RETEST": 30,
            "FRESH_LEVEL": 25,
            "ENGULFING": 15,
        }

        score += entry_scores.get(
            entry["entry_type"],
            0,
        )

        signal["confidence"] = min(
            score,
            100,
        )

        # ==================================================
        # CLEANUP
        # ==================================================

        remove_setup(symbol)

        if DEBUG:

            print("=" * 60)
            print(f"{symbol} | SIGNAL GENERATED")
            print(f"Direction  : {direction}")
            print(f"Setup      : {setup['setup']}")
            print(
                f"Entry Type : {entry['entry_type']}"
            )
            print(
                f"Confidence : {signal['confidence']}%"
            )
            print("=" * 60)

        return signal

    except Exception as exc:

        print("\n" + "=" * 60)
        print("STRATEGY ENGINE ERROR")
        print("=" * 60)
        print(f"Symbol : {symbol}")
        print(f"Error  : {exc}")
        traceback.print_exc()
        print("=" * 60)

        return None